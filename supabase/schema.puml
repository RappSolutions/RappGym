@startuml RappGym
' RappGym data model (public schema). Keep in sync with drizzle/migrations.
hide circle
hide empty methods
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0042AD
}

entity "auth.users" as users {
  * id : uuid <<PK>>
  --
  email : text
}
entity user_roles {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * role : app_role (admin|user)
}
entity admin_user_views {
  * id : uuid <<PK>>
  --
  * auth_session_id : uuid <<UQ active>>
  * actor_id : uuid
  * target_user_id : uuid
  * started_at : timestamptz
  ended_at : timestamptz
}
entity gyms {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  * name : text
  description : text
  * is_public : boolean
  created_at : timestamptz
}
entity exercises {
  * id : uuid <<PK>>
  --
  * code : text <<UQ, derived prefix||code_number>>
  * code_number : int <<UQ(category_id)>>
  * name : text
  * category_id : uuid <<FK>>
  equipment_id : uuid <<FK>>
  * reps_unit : text  -- reps|sec|min
  instructions : text
  image_urls : jsonb
  translations : jsonb
  * is_active : boolean
  sort_order : int
  * user_id : uuid
}
entity exercise_categories {
  * id : uuid <<PK>>
  --
  * name : text <<UQ>>
  * code_prefix : text <<UQ>>
  * color_token : text
  sort_order : int
}
entity exercise_equipment {
  * id : uuid <<PK>>
  --
  * name : text <<UQ>>
}
entity exercise_locations {
  * exercise_id : uuid <<PK,FK>>
  * gym_id : uuid <<PK,FK>>
  --
  * user_id : uuid
  created_at : timestamptz
}
entity workouts {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  * title : text
  * created_by : text (user|ai)
  scheduled_date : date
  gym_id : uuid <<FK>>
  * is_circuit : boolean
  * is_spontaneous : boolean
  ai_history_id : uuid <<FK>>
  ai_workout_key : text
  source_workout_id : uuid <<FK>>
  note : text
  started_at : timestamptz
  completed_at : timestamptz
  * created_at : timestamptz
}
entity workout_exercises {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  * workout_id : uuid <<FK CASCADE>>
  * exercise_id : uuid <<FK RESTRICT>>
  * phase : text (intro|main|outro)
  * sort_order : int
  * target_sets : int
  target_reps : int
  * target_load : text
  note : text
  * created_at : timestamptz
}
entity log_entries {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  workout_id : uuid <<FK>>
  exercise_id : uuid <<FK>>
  * code : text <<snapshot>>
  * exercise_name : text <<snapshot>>
  * reps_unit : text <<snapshot>>
  * date : date
  * status : text (completed)
  * sets : int
  reps : int
  load : text
  note : text
  gym_id : uuid <<FK>>
  proposal_order : int
  * phase : text (intro|main|outro)
  exercise_rating : smallint 1-5 <<snapshot, completed only>>
  lap : smallint <<actual circuit lap, nullable for legacy>>
  set_number : smallint <<actual set ordinal, nullable for legacy>>
  * created_at : timestamptz
}
entity ai_tiers {
  * id : text <<PK>>
  --
  * name : text
  monthly_ai_quota : integer (NULL = unlimited)
  * is_default : boolean (unique when true)
}

entity user_ai_quotas {
  * user_id : uuid <<PK>>
  --
  * tier_id : text <<FK ai_tiers RESTRICT>>
  custom_quota : integer (0 = throttled)
  * is_blocked : boolean
  valid_until : date
  notes : text
  updated_by : uuid
}

entity training_ai_history {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  * request : jsonb
  * insights : jsonb
  * language : text
  * today : date
  gym_id : uuid <<FK>>
  model : text
  input_tokens, output_tokens : int
  cost_usd : numeric
  * generated_at : timestamptz
}
entity training_goals {
  * id : uuid <<PK>>
  --
  * user_id : uuid
  * text : text
  target_date : date
  * status : text
  * created_at : timestamptz
}
entity training_profiles {
  * user_id : uuid <<PK>>
  --
  birth_year, height_cm : int
  weight_kg : numeric
  experience, limitations, preferences, pace : text
  * use_for_ai : boolean
  updated_at : timestamptz
}

users ||--o{ user_roles : "CASCADE"
users ||..o{ admin_user_views : "actor / target (read-only audit)"
users ||..o{ gyms
users ||..o{ workouts
users ||..o{ log_entries
users ||..o{ training_ai_history
users ||..o| user_ai_quotas
ai_tiers ||--o{ user_ai_quotas : "RESTRICT"
users ||..o{ training_goals
users ||..o| training_profiles
exercises ||--o{ exercise_locations : "CASCADE"
gyms ||--o{ exercise_locations : "CASCADE"
exercises ||--o{ log_entries : "RESTRICT"
exercises ||--o{ workout_exercises : "RESTRICT"
workouts ||--o{ workout_exercises : "CASCADE"
exercise_categories ||--o{ exercises : "RESTRICT"
exercise_equipment |o--o{ exercises : "RESTRICT"
workouts |o--o{ log_entries : "SET NULL"
gyms |o--o{ log_entries : "SET NULL"
gyms |o--o{ workouts : "SET NULL"
training_ai_history |o--o{ workouts : "SET NULL"
workouts |o--o{ workouts : "source (SET NULL)"
gyms |o..o{ training_ai_history
entity user_exercise_preferences {
  * user_id : uuid <<PK>>
  * exercise_id : uuid <<PK,FK>>
  --
  rating : smallint (1,2,4,5; none = 3)
  updated_at : timestamptz
}
exercises ||--o{ user_exercise_preferences
entity exercise_suggestions {
  * id : uuid <<PK>>
  * user_id : uuid
  * name : text
  category_id : uuid <<FK>>
  equipment_id : uuid <<FK>>
  * instructions : text
  source_url : text
  * created_at : timestamptz
}
users ||..o{ exercise_suggestions
exercise_categories |o--o{ exercise_suggestions : "RESTRICT"
exercise_equipment |o--o{ exercise_suggestions : "RESTRICT"
@enduml
